# Supabase
# Server-only, both of them. NEXT_PUBLIC_SUPABASE_URL is still accepted as a
# legacy alias, but the NEXT_PUBLIC_ prefix advertises a value as browser-safe,
# which this one is not — prefer SUPABASE_URL.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (optional until provided — leads still save to Supabase)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Comma-separated list — every address here receives each new lead
LEAD_TO_EMAIL=monicajr@system-weavers.com,Griselmarie@system-weavers.com
